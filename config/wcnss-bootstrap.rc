# SPDX-License-Identifier: MIT
# Tested fragment from the test44 boot ramdisk's init.rc.
# Append once to the target init.rc; do not create a duplicate trigger.
# 802w: firmware and Prima must be ready before Android enables Wi-Fi.
on post-fs-data
    exec u:r:init:s0 root root -- /system/bin/wcnss-init
    setprop wlan.driver.status ok
